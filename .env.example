# Copy to .env.local and adjust. Expo exposes EXPO_PUBLIC_* variables to the app bundle.

# cashya-api base URL (without /api/v1).
# Empty = Android emulator http://10.0.2.2:8000, iOS simulator/web http://127.0.0.1:8000.
# Physical phone: use your computer's LAN IP, e.g. http://192.168.0.10:8000 (same Wi-Fi).
EXPO_PUBLIC_API_URL=

# Must equal the backend's REQUEST_SIGNING_SECRET (leave both empty to send unsigned requests).
# Anything EXPO_PUBLIC_* ships inside the app, so this only raises the bar: auth is still the bearer token.
EXPO_PUBLIC_API_SIGNING_KEY=
