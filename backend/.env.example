DATABASE_URL=sqlite:///./cashya.db
SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ISSUER=cashya-api
JWT_AUDIENCE=cashya-app
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
MAX_REQUEST_BODY_BYTES=1048576
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
API_V1_PREFIX=/api/v1

# --- Hardening (see README "Camada anti engenharia reversa") ---
ENVIRONMENT=development
EXPOSE_DOCS=true
TRUST_PROXY_HEADERS=false
GLOBAL_RATE_LIMIT_PER_MINUTE=300
# Shared with the app (EXPO_PUBLIC_API_SIGNING_KEY). Empty = requests are not signed.
REQUEST_SIGNING_SECRET=
REQUEST_SIGNATURE_MAX_SKEW_SECONDS=300
MIN_CLIENT_VERSION=
HSTS_ENABLED=false
